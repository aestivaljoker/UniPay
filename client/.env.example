# ---------------------------------------------------------------------------
# UniPay client configuration
# ---------------------------------------------------------------------------
# Copy this file to client/.env and edit if you need to.
#
# YOU USUALLY DO NOT NEED THIS FILE.
#
# Leave VITE_API_URL unset and the client calls the API on its own origin:
#   - `npm run dev`  → Vite proxies /api and /socket.io to localhost:5000
#   - production build served by Express → same origin, nothing to configure
#
# Set it only when the browser must reach the backend at a DIFFERENT address
# than the one it loaded the page from. Example: you serve the UI from the Vite
# dev server on the laptop but want phones to hit the API directly.
#
# Find your laptop's IPv4 address with `ipconfig` (Windows), then:
# VITE_API_URL=http://192.168.1.100:5000

# VITE_API_URL=

# Where `npm run dev` forwards /api and /socket.io. Change this if you started
# the backend on a non-default port.
# VITE_PROXY_TARGET=http://localhost:5000
